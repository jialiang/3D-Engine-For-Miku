{
  "name": "3d-engine-for-miku",
  "version": "1.0.0",
  "description": "A personal 3D JavaScript engine for playing MMD file formats",
  "private": true,
  "scripts": {
    "dev": "http-server -c-1 -o",
    "grounding": "node tools/ground.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quantize": "node tools/quantize.js models/pierretta/pierretta.glb"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.5"
  }
}
